<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_activity"
    tools:context=".Random1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="160dp"
            android:background="@null"
            android:text="@string/random_counter"
            android:textColor="@color/white"
            android:textSize="150sp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/random1_plus"
            android:layout_width="190sp"
            android:layout_height="50sp"
            android:layout_gravity="center"
            android:layout_marginTop="120dp"
            android:background="@drawable/btn_yellow"
            android:fontFamily="@font/permanent_marker"
            android:text="@string/random1_plus"
            android:textColor="@color/white"
            android:textSize="36sp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/random1_minus"
            android:layout_width="190sp"
            android:layout_height="50sp"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_yellow"
            android:fontFamily="@font/permanent_marker"
            android:text="@string/random1_minus"
            android:textColor="@color/white"
            android:textSize="36sp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/random1_random"
            android:layout_width="190sp"
            android:layout_height="50sp"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_yellow"
            android:fontFamily="@font/permanent_marker"
            android:text="@string/random1_random"
            android:textColor="@color/white"
            android:textSize="16sp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>