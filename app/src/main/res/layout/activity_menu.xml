<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_activity"
    tools:context=".Menu">

    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/menu_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/btn_yellow"
            android:fontFamily="@font/permanent_marker"
            android:onClick="menu_profile"
            android:text="@string/menu_profile"
            android:textColor="@color/white"
            android:textSize="40sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/menu_media"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_yellow"
            android:fontFamily="@font/permanent_marker"
            android:onClick="menu_media"
            android:textColor="@color/white"
            android:textSize="40sp"
            android:layout_marginTop="20dp"
            android:text="@string/menu_media"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/menu_random"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_yellow"
            android:fontFamily="@font/permanent_marker"
            android:onClick="menu_random"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:layout_marginTop="20dp"
            android:text="@string/menu_random"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/menu_exit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_exit"
            android:fontFamily="@font/permanent_marker"
            android:onClick="menu_exit"
            android:textColor="@color/white"
            android:textSize="40sp"
            android:layout_marginTop="160dp"
            android:text="@string/menu_exit"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>